# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to access /app
ADMIN_EMAIL_ALLOWLIST=romantra@example.com

# --- WordPress.com site + OAuth2 ---
WP_SITE_DOMAIN=romantraspence.com

# Create at WordPress.com Developer tools -> Apps
WP_CLIENT_ID=
WP_CLIENT_SECRET=

# WordPress.com account username/email
WP_USERNAME=
# WordPress.com application password (recommended) OR your regular password (not recommended)
WP_APP_PASSWORD=
